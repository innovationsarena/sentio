[Unit]
Description=Sentio SMTP - Multi-tenant Email Platform
Documentation=https://github.com/truespar/sentio

# Hard dependencies. Sentio exits at startup if the KV store or the queue is
# unreachable, so there is no point starting before they are up.
Requires=postgresql.service nats.service redis-server.service

# Optional. Sentio starts without these and loses a feature each:
#   rspamd        -> spam scoring falls back to the builtin scorer
#   clamav-daemon -> attachments are not virus-scanned
Wants=rspamd.service clamav-daemon.service
Wants=network-online.target

After=network-online.target postgresql.service nats.service redis-server.service rspamd.service clamav-daemon.service

[Service]
Type=simple

# Create this account before enabling the unit:
#   sudo useradd --system --home-dir /var/lib/sentio --shell /usr/sbin/nologin sentio
User=sentio
Group=sentio

ExecStart=/usr/local/bin/sentio-smtp --config /etc/sentio/sentio.toml
# No ExecReload: Sentio has no SIGHUP handler, so a reload signal would
# terminate the process (libc default). certbot's post-renewal hook uses
# `systemctl reload-or-restart`, which without ExecReload falls through
# to a full restart - the only way TLS cert changes take effect anyway.
Restart=always
RestartSec=5

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ProtectSystem=strict makes everything outside these read-only. Add
# /etc/sentio/acme here too if you enable the built-in ACME client.
ReadWritePaths=/var/lib/sentio

# Bind privileged ports 25 / 465 / 587 as a non-root user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentio-smtp

[Install]
WantedBy=multi-user.target
